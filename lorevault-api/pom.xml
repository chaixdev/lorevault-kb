<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lorevault</groupId>
        <artifactId>lorevault-parent</artifactId>
    <version>0.8.3-SNAPSHOT</version>
    </parent>

    <artifactId>lorevault-api</artifactId>
    <packaging>jar</packaging>

    <name>LoreVault API</name>
    <description>REST API module for LoreVault service</description>

    <properties>
        <!-- Skip JaCoCo check by default (reports still generated); enable in CI via -Pcoverage-gate -->
        <jacoco.check.skip>true</jacoco.check.skip>
    </properties>

    <dependencies>
        <!-- Spring AI OpenAI client (core library only, no auto-configuration) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>
        
        <!-- Spring AI Chat Client (for ChatClient interface) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-client-chat</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        
        <!-- Neo4j (graph persistence) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-neo4j</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Retry -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aspects</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- NLP: Entity extraction from query text -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-tools</artifactId>
            <version>2.5.4</version>
        </dependency>
        <dependency>
            <groupId>org.ahocorasick</groupId>
            <artifactId>ahocorasick</artifactId>
            <version>0.6.3</version>
        </dependency>

        <!-- OpenAPI Documentation -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>neo4j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Architecture Testing -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.2.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>        
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Ensure the repackaged Boot jar does NOT replace the main artifact, so tests use the plain jar -->
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <!-- Parallelize test execution: 1C = one fork per CPU core -->
                    <forkCount>1C</forkCount>
                    <reuseForks>true</reuseForks>
                    <!-- Reuse JVM for speed; JUnit5 parallelism is configured via junit-platform.properties -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <!-- Pragmatic default: skip ITs and heavy integration tests in unit test phase -->
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                        <exclude>**/*ITCase.java</exclude>
                        <exclude>**/*ITCase*.java</exclude>
                        <exclude>**/*IntegrationTest.java</exclude>
                        <exclude>**/*IntegrationTests.java</exclude>
                    </excludes>
                    <!-- Also honor JUnit 5 @Tag("integration") as excluded by default -->
                    <excludedGroups>integration,architecture</excludedGroups>
                    <properties>
                        <configurationParameters>junit.jupiter.tags.exclude=architecture</configurationParameters>
                    </properties>
                </configuration>
            </plugin>
            
            <!-- JaCoCo Code Coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- Make the coverage gate opt-in; default is skipped locally -->
                            <skip>${jacoco.check.skip}</skip>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.lorevault.api.ai.*</include>
                                        <include>com.lorevault.api.content.*</include>
                                        <include>com.lorevault.api.health.*</include>
                                        <include>com.lorevault.api.ingestion.*</include>
                                        <include>com.lorevault.api.library.*</include>
                                        <include>com.lorevault.api.search.*</include>
                                        <include>com.lorevault.api.timeline.*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <!-- Exclude wiring and transport layers from unit coverage requirements -->
                                <exclude>com/lorevault/api/config/**</exclude>
                                <exclude>com/lorevault/api/web/**</exclude>
                                <!-- Exclude main application class -->
                                <exclude>com/lorevault/api/LoreVaultApiApplication.*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            
            <!-- PIT Mutation Testing moved to profile 'mutation-testing' for opt-in CI runs -->
        </plugins>
    </build>

    <!-- Optional profile to run integration tests explicitly: mvn verify -P integration-tests -->
    <profiles>
        <profile>
            <id>integration-tests</id>
            <build>
                <plugins>
                    <!-- Reconfigure Surefire in this profile to include integration-tagged tests, if desired -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.1.2</version>
                        <configuration>
                            <!-- Keep default unit tests; allow opting into @Tag("integration") too -->
                            <excludedGroups></excludedGroups>
                            <groups>integration</groups>
                        </configuration>
                    </plugin>
                    <!-- Use Failsafe to run file-pattern-based integration tests in the integration-test/verify phases -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.1.2</version>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                                <include>**/*ITCase.java</include>
                                <include>**/*IntegrationTest.java</include>
                                <include>**/*IntegrationTests.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>architecture-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.1.2</version>
                        <configuration>
                            <!-- Run only architecture tests by file path to avoid tag filter pitfalls -->
                            <forkCount>1C</forkCount>
                            <reuseForks>true</reuseForks>
                            <includes combine.self="override">
                                <include>**/architecture/**/*Test.java</include>
                                <include>**/architecture/**/*Tests.java</include>
                            </includes>
                            <!-- Fully override the exclude list to NOT exclude architecture tests -->
                            <excludes combine.self="override">
                                <!-- Keep IT patterns excluded; do NOT exclude architecture here -->
                                <exclude>**/*IT.java</exclude>
                                <exclude>**/*ITCase.java</exclude>
                                <exclude>**/*ITCase*.java</exclude>
                                <exclude>**/*IntegrationTest.java</exclude>
                                <exclude>**/*IntegrationTests.java</exclude>
                            </excludes>
                            <!-- Clear tag filters to not exclude anything by tag -->
                            <excludedGroups combine.self="override"></excludedGroups>
                            <properties combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Enable strict JaCoCo coverage gate: mvn verify -P coverage-gate -->
        <profile>
            <id>coverage-gate</id>
            <properties>
                <jacoco.check.skip>false</jacoco.check.skip>
            </properties>
        </profile>
        <profile>
            <id>mutation-testing</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.15.3</version>
                        <configuration>
                            <targetClasses>
                                <param>com.lorevault.api.service.*</param>
                                <param>com.lorevault.api.domain.*</param>
                                <param>com.lorevault.api.application.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.lorevault.api.service.*</param>
                                <param>com.lorevault.api.domain.*</param>
                                <param>com.lorevault.api.application.*</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>**/*IT</param>
                                <param>**/*IntegrationTest</param>
                                <param>**/*TCKTest</param>
                            </excludedTestClasses>
                            <mutationThreshold>80</mutationThreshold>
                            <coverageThreshold>85</coverageThreshold>
                            <timestampedReports>false</timestampedReports>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                            <outputFormats>
                                <outputFormat>XML</outputFormat>
                                <outputFormat>HTML</outputFormat>
                            </outputFormats>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>pit-report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
