meta {
  name: 05-checkChapter1JobComplete
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/query/jobs/:jobId
  body: none
  auth: inherit
}

params:path {
  jobId: {{chapter1JobId}}
}

script:post-response {
  const body = res.getBody();
  console.log("Chapter 1 job status:", body.currentStatus, body.progressPercent + "%");
  if (body.currentStatus !== "COMPLETE") {
    console.log("Re-run this request until the job reaches COMPLETE.");
    throw new Error("Chapter 1 ingestion not complete yet");
  }
  bru.setVar("chapter1Id", body.chapterId);
}
