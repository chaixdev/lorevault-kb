meta {
  name: 08-ingestChapter3-Aftermath
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/command/ingest
  body: multipartForm
  auth: inherit
}

params:query {
  bookId: {{bookId}}
  chapterNumber: 3
}

body:multipart-form {
  file: {{chapter3File}}
}

script:post-response {
  const body = res.getBody();
  if (!body.jobId) {
    throw new Error("Missing jobId in response");
  }
  bru.setVar("chapter3JobId", body.jobId);
  console.log("Chapter 3 ingest job:", body.jobId);
}
