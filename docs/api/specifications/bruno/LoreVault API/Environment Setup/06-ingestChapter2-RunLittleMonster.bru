meta {
  name: 06-ingestChapter2-RunLittleMonster
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/command/ingest
  body: multipartForm
  auth: inherit
}

params:query {
  bookId: {{bookId}}
  chapterNumber: 2
}

body:multipart-form {
  file: {{chapter2File}}
}

script:post-response {
  const body = res.getBody();
  if (!body.jobId) {
    throw new Error("Missing jobId in response");
  }
  bru.setVar("chapter2JobId", body.jobId);
  console.log("Chapter 2 ingest job:", body.jobId);
}
