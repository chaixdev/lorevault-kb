meta {
  name: 02-createDeathworldersSeries
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/command/library/create-series
  body: json
  auth: inherit
}

body:json {
  {
    "universeId": "{{universeId}}",
    "name": "Deathworlders"
  }
}

script:post-response {
  const body = res.getBody();
  if (!body.seriesId) {
    throw new Error("Missing seriesId in response");
  }
  bru.setVar("seriesId", body.seriesId);
  console.log("Series:", body.name, body.seriesId, "created=", body.created);
}
