meta {
  name: 04-ingestChapter1-KevinJenkinsExperience
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/command/ingest
  body: multipartForm
  auth: inherit
}

params:query {
  bookId: {{bookId}}
  chapterNumber: 1
}

body:multipart-form {
  file: {{chapter1File}}
}

script:post-response {
  const body = res.getBody();
  if (!body.jobId) {
    throw new Error("Missing jobId in response");
  }
  bru.setVar("chapter1JobId", body.jobId);
  console.log("Chapter 1 ingest job:", body.jobId);
}
