meta {
  name: 03-createBook0-KevinJenkinsExperience
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/command/library/create-book
  body: json
  auth: inherit
}

body:json {
  {
    "universeId": "{{universeId}}",
    "seriesId": "{{seriesId}}",
    "title": "The Kevin Jenkins Experience",
    "bookNumber": 0
  }
}

script:post-response {
  const body = res.getBody();
  if (!body.bookId) {
    throw new Error("Missing bookId in response");
  }
  bru.setVar("bookId", body.bookId);
  console.log("Book:", body.title, body.bookId, "created=", body.created);
}
