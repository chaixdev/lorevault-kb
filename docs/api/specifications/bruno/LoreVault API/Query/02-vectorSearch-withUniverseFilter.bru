meta {
  name: 02-vectorSearch-withUniverseFilter
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/query/ask/vector
  body: json
  auth: inherit
}

body:json {
  {
    "query": "Kevin Jenkins",
    "topK": 5,
    "threshold": 0.5,
    "filters": {
      "universe": "JENKINSVERSE"
    }
  }
}

script:post-response {
  const body = res.getBody();
  console.log("Results with JENKINSVERSE filter:", body.results.length);
  if (body.results.length > 0) {
    console.log("✓ Filter working: found results");
  }
}
