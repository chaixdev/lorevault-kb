meta {
  name: 01-vectorSearch-noFilters
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/query/ask/vector
  body: json
  auth: inherit
}

body:json {
  {
    "query": "Kevin Jenkins",
    "topK": 5,
    "threshold": 0.5
  }
}

script:post-response {
  const body = res.getBody();
  console.log("Results returned:", body.results.length);
  if (body.results.length === 0) {
    console.log("WARNING: No results found. Ensure vector index is populated.");
  } else {
    console.log("First result score:", body.results[0].score);
  }
}
