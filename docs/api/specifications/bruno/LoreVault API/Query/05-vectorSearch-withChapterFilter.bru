meta {
  name: 05-vectorSearch-withChapterFilter
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/query/ask/vector
  body: json
  auth: inherit
}

body:json {
  {
    "query": "Kevin Jenkins",
    "topK": 5,
    "threshold": 0.5,
    "filters": {
      "universe": "JENKINSVERSE",
      "series": "Deathworlders",
      "bookNumber": 0,
      "chapterNumber": 1
    }
  }
}

script:post-response {
  const body = res.getBody();
  console.log("Results with chapter filter (Deathworlders 0.1):", body.results.length);
  if (body.results.length > 0) {
    console.log("✓ Chapter filter working");
  }
}
