meta {
  name: 06-rag-noFilters
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/query/ask/rag
  body: json
  auth: inherit
}

body:json {
  {
    "question": "Who is Kevin Jenkins?",
    "topK": 5,
    "threshold": 0.5
  }
}

script:post-response {
  const body = res.getBody();
  console.log("RAG answer length:", body.answer ? body.answer.length : 0);
  console.log("Citations:", body.citations.length);
  if (body.citations.length > 0) {
    const firstCite = body.citations[0].publicationCoordinates;
    console.log("First citation:", {
      universe: firstCite.universe,
      series: firstCite.series,
      bookNumber: firstCite.bookNumber,
      chapterNumber: firstCite.chapterNumber
    });
  }
}
