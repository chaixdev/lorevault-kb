{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lorevault.dev/schemas/claims.schema.json",
  "title": "LoreVault Claims Document",
  "type": "object",
  "required": ["context", "claims"],
  "properties": {
    "context": {
      "type": "object",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "role": { "type": "string", "enum": ["narrator", "character", "document", "system"] },
            "entityId": { "$ref": "#/$defs/EntityId" }
          },
          "required": ["role"],
          "additionalProperties": false
        },
        "pub": { "$ref": "#/$defs/PublicationCoordinates" },
        "chapterId": { "type": "string" },
        "sceneIndex": { "type": "integer", "minimum": 0 }
      },
      "required": ["source", "pub"],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/Claim" },
      "minItems": 1
    }
  },
  "$defs": {
    "EntityId": { "type": "string", "pattern": "^E:(individual|collective|object|location|concept|event)/[a-z0-9._-]+$" },
    "PropertyId": { "type": "string", "pattern": "^P:[a-z][a-z0-9_.-]*$" },
    "RelTypeId": { "type": "string", "pattern": "^R:[a-z][a-z0-9_.-]*$" },
    "PublicationCoordinates": {
      "type": "object",
      "properties": {
        "universe": { "type": "string", "minLength": 1 },
        "series": { "type": "string" },
        "bookNumber": { "type": "integer", "minimum": 1 },
        "chapterNumber": { "type": "integer", "minimum": 1 },
        "sceneIndex": { "type": "integer", "minimum": 0 },
        "pubOrdinal": { "type": "integer", "minimum": 0 },
        "pubKey": { "type": "string" }
      },
      "required": ["universe", "bookNumber", "chapterNumber", "sceneIndex"],
      "additionalProperties": false
    },
    "Qualifiers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    },
    "Offsets": {
      "type": "object",
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "SourcePolarity": { "type": "string", "enum": ["assert", "deny"] },
    "ComparisonOp": { "type": "string", "enum": ["lt", "gt", "eq", "approx"] },
    "Value": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "$ref": "#/$defs/EntityId" },
        {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["string", "number", "boolean", "date", "quantity"] },
            "value": { "oneOf": [ { "type": "string" }, { "type": "number" }, { "type": "boolean" } ] },
            "unit": { "type": "string" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        }
      ]
    },
    "ClaimBase": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["ascription", "relation", "comparison"] },
        "subjectId": { "$ref": "#/$defs/EntityId" },
        "certainty": { "type": "number", "minimum": 0, "maximum": 1 },
        "polarity": { "$ref": "#/$defs/SourcePolarity" },
        "qualifiers": { "$ref": "#/$defs/Qualifiers" },
        "chunkId": { "type": "string" },
        "offsets": { "$ref": "#/$defs/Offsets" },
        "pub": { "$ref": "#/$defs/PublicationCoordinates" }
      },
      "required": ["type", "subjectId", "certainty"],
      "additionalProperties": false
    },
    "Ascription": {
      "allOf": [
        { "$ref": "#/$defs/ClaimBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "ascription" },
            "propertyId": { "$ref": "#/$defs/PropertyId" },
            "propertyDescription": { "type": "string", "minLength": 1 },
            "value": { "$ref": "#/$defs/Value" },
            "subjectivity": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["value"],
          "oneOf": [
            { "required": ["propertyId"] },
            { "required": ["propertyDescription"] }
          ],
          "additionalProperties": false
        }
      ]
    },
    "Relation": {
      "allOf": [
        { "$ref": "#/$defs/ClaimBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "relation" },
            "relTypeId": { "$ref": "#/$defs/RelTypeId" },
            "relationDescription": { "type": "string", "minLength": 1 },
            "objectId": { "$ref": "#/$defs/EntityId" }
          },
          "required": ["objectId"],
          "oneOf": [
            { "required": ["relTypeId"] },
            { "required": ["relationDescription"] }
          ],
          "additionalProperties": false
        }
      ]
    },
    "Comparison": {
      "allOf": [
        { "$ref": "#/$defs/ClaimBase" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "comparison" },
            "propertyId": { "$ref": "#/$defs/PropertyId" },
            "propertyDescription": { "type": "string", "minLength": 1 },
            "op": { "$ref": "#/$defs/ComparisonOp" },
            "targetId": { "$ref": "#/$defs/EntityId" }
          },
          "required": ["op", "targetId"],
          "oneOf": [
            { "required": ["propertyId"] },
            { "required": ["propertyDescription"] }
          ],
          "additionalProperties": false
        }
      ]
    },
    "Claim": {
      "oneOf": [
        { "$ref": "#/$defs/Ascription" },
        { "$ref": "#/$defs/Relation" },
        { "$ref": "#/$defs/Comparison" }
      ]
    }
  },
  "additionalProperties": false
}
