# LoreVault Development Environment

# Neo4j credentials used by lorevault-api/src/main/resources/application.yml
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neosecret

# LLM provider keys
# OpenRouter is used for embeddings (perplexity/pplx-embed-v1-4b) and can also be used for chat models
OPENROUTER_API_KEY=
# Groq is used for chat models (nlp-small, nlp-big)
GROQ_API_KEY=
# Gemini key is no longer needed for embeddings; keep only if you switch back to Gemini embedding model
# GEMINI_AI_API_KEY=

# Optional overrides
# SERVER_PORT=18080
