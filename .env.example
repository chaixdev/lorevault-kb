# LoreVault Development Environment

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lorevault
SPRING_DATASOURCE_USERNAME=lorevault
SPRING_DATASOURCE_PASSWORD=lorevault

# Server Configuration
SERVER_PORT=8080

# Development Settings
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Actuator Settings
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

GEMINI_AI_API_KEY=
GEMINI_AI_PROJECT_ID=
GROQ_API_KEY=